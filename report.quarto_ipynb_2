    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: tbl-gva-gaps\n",
        "#| tbl-cap: Regions without sector values in every year 2000-2024, by country\n",
        "sec_span = sec_clean.groupby(\"geo\")[\"year\"].agg(first_year=\"min\", last_year=\"max\", years=\"nunique\")\n",
        "sec_span[\"country\"] = sec_span.index.str[:2]\n",
        "sec_gaps = sec_span[sec_span[\"years\"] < 25].groupby(\"country\").agg(\n",
        "    regions=(\"years\", \"size\"), first_year=(\"first_year\", \"min\"), last_year=(\"last_year\", \"max\"), years_with_data=(\"years\", \"min\"))\n",
        "sec_gaps.index = [{\"BE\": \"Belgium\", \"DE\": \"Germany\", \"NL\": \"Netherlands\", \"PL\": \"Poland\"}.get(c, c) for c in sec_gaps.index]\n",
        "sec_gaps"
      ],
      "id": "tbl-gva-gaps",
