        "#| label: tbl-emp-robustness\n",
        "#| tbl-cap: 'Employment convergence, 2000-2024: ages 20-64 (main) and ages 15-64 (check), same regions'\n",
        "\n",
        "def employment_change(file):\n",
        "    \"\"\"One row per region: employment rate in 2000, 2024 and the change in percentage points.\"\"\"\n",
        "    d = pd.read_csv(file)                       # no fallback: if a file is missing, this stops with an error\n",
        "    d = d[d[\"year\"].isin([2000, 2024])]\n",
        "    w = d.pivot(index=\"geo\", columns=\"year\", values=\"emp_rate\").dropna(subset=[2000, 2024]).copy()\n",
        "    w[\"change\"] = w[2024] - w[2000]\n",
        "    return w\n",
        "\n",
        "emp_20 = employment_change(\"data/clean/emp.csv\")\n",
        "emp_15 = employment_change(\"data/clean/emp_15_64.csv\")\n",
        "\n",
        "# Same regions for both age groups\n",
        "common = emp_20.index.intersection(emp_15.index)\n",
        "emp_20, emp_15 = emp_20.loc[common], emp_15.loc[common]\n",
        "\n",
        "# Safety check: stop if the two \"age groups\" are the same numbers (this is what went wrong before)\n",
        "assert not emp_20[2000].equals(emp_15[2000]), \"20-64 and 15-64 data are identical: check emp_15_64.csv\"\n",
