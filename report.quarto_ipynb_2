        "#| label: q2-gdp-analysis\n",
        "#| fig-cap: GDP beta-convergence across EU regions, 2000-2024\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import linregress\n",
        "\n",
        "# 1. Load the cleaned GDP dataset\n",
        "gdp_q2 = pd.read_csv(\"data/clean/gdp.csv\")\n",
        "\n",
        "# Ensure variables are numeric\n",
        "gdp_q2[\"year\"] = pd.to_numeric(gdp_q2[\"year\"], errors=\"coerce\")\n",
        "gdp_q2[\"gdp_pps\"] = pd.to_numeric(gdp_q2[\"gdp_pps\"], errors=\"coerce\")\n",
        "\n",
        "# 2. Select the beginning and end of the study period\n",
        "gdp_period = gdp_q2[\n",
        "    gdp_q2[\"year\"].isin([2000, 2024])\n",
        "].copy()\n",
        "\n",
        "# 3. Arrange data so each region has one row\n",
        "gdp_wide = gdp_period.pivot(\n",
        "    index=\"geo\",\n",
        "    columns=\"year\",\n",
        "    values=\"gdp_pps\"\n",
        ")\n",
        "\n",
        "# Keep regions with observations in both years\n",
        "gdp_wide = gdp_wide.dropna(subset=[2000, 2024])\n",
        "\n",
        "# Remove invalid or non-positive GDP observations\n",
        "gdp_wide = gdp_wide[\n",
        "    (gdp_wide[2000] > 0) &\n",
        "    (gdp_wide[2024] > 0)\n",
        "].copy()\n",
        "\n",
        "# 4. Calculate initial GDP and annual economic growth\n",
        "gdp_wide[\"initial_log_gdp\"] = np.log(gdp_wide[2000])\n",
        "\n",
        "gdp_wide[\"annual_growth\"] = (\n",
        "    np.log(gdp_wide[2024]) -\n",
        "    np.log(gdp_wide[2000])\n",
        ") / 24\n",
        "\n",
        "gdp_wide[\"growth_percent\"] = (\n",
        "    (gdp_wide[2024] / gdp_wide[2000]) ** (1 / 24) - 1\n",
        ") * 100\n",
        "\n",
        "# 5. Run beta-convergence regression\n",
        "gdp_model = linregress(\n",
        "    gdp_wide[\"initial_log_gdp\"],\n",
        "    gdp_wide[\"annual_growth\"]\n",
        ")\n",
        "\n",
        "# 6. Display regression results\n",
        "print(\"GDP BETA-CONVERGENCE RESULTS\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "print(\"Number of regions:\", len(gdp_wide))\n",
        "print(\"Regression coefficient:\", round(gdp_model.slope, 5))\n",
        "print(\"R-squared:\", round(gdp_model.rvalue ** 2, 3))\n",
        "print(\"P-value:\", f\"{gdp_model.pvalue:.4g}\")\n",
        "\n",
        "if gdp_model.slope < 0 and gdp_model.pvalue < 0.05:\n",
        "    print(\"Conclusion: Evidence of beta-convergence.\")\n",
        "else:\n",
        "    print(\"Conclusion: No statistically significant evidence of beta-convergence.\")\n",
        "\n",
        "# 7. Compare growth across initial-income groups\n",
        "gdp_wide[\"income_group\"] = pd.qcut(\n",
        "    gdp_wide[2000],\n",
        "    q=4,\n",
        "    labels=[\"Poorest\", \"Lower-middle\", \"Upper-middle\", \"Richest\"]\n",
        ")\n",
        "\n",
        "quartile_results = gdp_wide.groupby(\n",
        "    \"income_group\",\n",
        "    observed=True\n",
        ")[\"growth_percent\"].mean()\n",
        "\n",
        "print(\"\\nAVERAGE ANNUAL GDP GROWTH BY INITIAL INCOME\")\n",
        "print(quartile_results.round(2))\n",
        "\n",
        "# 8. Create scatter plot and regression line\n",
        "plt.figure(figsize=(9, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    gdp_wide[\"initial_log_gdp\"],\n",
        "    gdp_wide[\"annual_growth\"] * 100,\n",
        "    alpha=0.7\n",
        ")\n",
        "\n",
        "x = np.linspace(\n",
        "    gdp_wide[\"initial_log_gdp\"].min(),\n",
        "    gdp_wide[\"initial_log_gdp\"].max(),\n",
        "    100\n",
        ")\n",
        "\n",
        "y = (\n",
        "    gdp_model.intercept +\n",
        "    gdp_model.slope * x\n",
        ") * 100\n",
        "\n",
        "plt.plot(x, y, linewidth=2)\n",
        "\n",
        "plt.xlabel(\"Initial log GDP per capita (2000)\")\n",
        "plt.ylabel(\"Average annual GDP growth (%)\")\n",
        "plt.title(\"GDP beta-convergence across EU regions, 2000-2024\")\n",
        "plt.grid(alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
