        "#| label: q3-tests\n",
        "# Do the groups explain growth? Differences between groups, then what the groups add to income and country\n",
        "def r2(y, X):\n",
        "    X = np.column_stack([np.ones(len(y)), X])\n",
        "    b = np.linalg.lstsq(X, y, rcond=None)[0]\n",
        "    return 1 - (y - X @ b).var() / y.var(), X.shape[1]\n",
        "\n",
        "y = q3_d[\"growth_pct\"].values\n",
        "G = pd.get_dummies(q3_d[\"group\"], drop_first=True).values.astype(float)            # group dummies\n",
        "C = pd.get_dummies(q3_d.index.str[:2], drop_first=True).values.astype(float)       # country dummies\n",
        "L = q3_d[[\"ln_gdp_2000\"]].values\n",
        "r_g, _ = r2(y, G); r_l, _ = r2(y, L); r_lg, _ = r2(y, np.column_stack([L, G]))\n",
        "r_c, k_c = r2(y, C); r_cg, k_cg = r2(y, np.column_stack([C, G]))\n",
        "F = ((r_cg - r_c) / (k_cg - k_c)) / ((1 - r_cg) / (len(y) - k_cg))\n",
        "\n",
        "kw = stats.kruskal(*[x[\"growth_pct\"].values for _, x in q3_d.groupby(\"group\")])\n",
        "print(f\"Regions: {len(q3_d)}. Growth differs between groups (Kruskal-Wallis): H = {kw.statistic:.1f}, p = {kw.pvalue:.1g}\")\n",
        "print(f\"Share of the differences in growth explained (R-squared): groups alone {r_g:.2f}; initial income alone {r_l:.2f}; income and groups {r_lg:.2f}\")\n",
        "print(f\"With country dummies: countries alone {r_c:.3f}; countries and groups {r_cg:.3f}; F-test for the groups: F = {F:.1f}, p = {stats.f.sf(F, k_cg - k_c, len(y) - k_cg):.2g}\")"
      ],
